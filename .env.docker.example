# Portfolio Docker 環境變數範本
# 複製此檔案為 .env 並填入真實值

# ==========================================
# 資料庫設定 (必填)
# ==========================================
DB_USERNAME=portfolio_user
DB_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# ==========================================
# 應用程式設定
# ==========================================
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:your_app_key_here

# ==========================================
# Sanctum 認證設定
# ==========================================
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_STATEFUL_DOMAINS=bb-made.com,www.bb-made.com,localhost:3000

# ==========================================
# 信任代理設定 (Cloudflare IP 範圍)
# ==========================================
# Cloudflare IPv4 完整清單，請定期更新：curl -s https://api.cloudflare.com/client/v4/ips
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22

# ==========================================
# CORS 設定
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# 郵件設定 (可選)
# ==========================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Portfolio"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=please_change_this

# ==========================================
# AI 服務設定 (可選，為 MoodCanvas 等專案提供)
# ==========================================
PERPLEXITY_API_KEY=your_perplexity_api_key_here
